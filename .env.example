# 端口号
PORT=8080

# 图片根目录
GALLERY_ROOT=/gallery

# 管理员用户名
ADMIN_USER=admin

# 管理员密码（账户凭据完全由环境变量控制，未设置时启动会生成随机密码）
ADMIN_PASSWORD=

# 会话密钥（未设置时自动生成并持久化到 data/session_secret）
# SESSION_SECRET=your-random-secret-here

# 信任的反向代理层数。0 = 不信任 X-Forwarded-For（直接暴露端口时必须为 0）
TRUST_PROXY=0

# 登录限流：单 IP 15 分钟内尝试上限
LOGIN_RATE_LIMIT_MAX=30

# API 限流：单用户每分钟请求上限
API_RATE_LIMIT_MAX=600

# 缩略图缓存目录
THUMB_DIR=/app/data/thumbs

# 缩略图大小（像素）
THUMB_SIZE=320

# 缩略图质量 (1-100)
THUMB_QUALITY=80

# 日志级别 (error, warn, info, debug)
LOG_LEVEL=info

# 运行环境 (development, production)
NODE_ENV=development
